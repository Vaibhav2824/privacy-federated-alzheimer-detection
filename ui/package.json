    "lint": "eslint src tests --max-warnings 0"
  },
  "dependencies": {
    "onnxruntime-web": "^1.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}

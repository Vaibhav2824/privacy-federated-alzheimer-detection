{
  "name": "ppxfl-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "In-browser demo and results dashboard for the PPXFL Alzheimer's detection study",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",

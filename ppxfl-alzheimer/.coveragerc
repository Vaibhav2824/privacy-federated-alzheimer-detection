# Coverage is measured on the project's pure-logic modules and held at 100%.
#
# The omitted modules are the GPU training entry points and analysis scripts:
# every line in them is a CUDA training loop, a matplotlib render or a tqdm
# progress bar, none of which can be exercised honestly on a CPU CI runner
# without real ADNI data. They are covered by the end-to-end experiment runs
# recorded in results_v2/, not by this suite. See tests/README.md.
[run]
branch = True
source = src
omit =
    src/__pycache__/*
    src/ablations.py
    src/centralised_train.py
    src/convert_dicom.py
    src/dp_train.py
    src/evaluate.py
    src/fl_client.py
    src/fl_server.py
    src/gradcam_analysis.py
    src/mia.py
    src/preprocess.py
    src/shap_analysis.py
    src/xai_similarity.py

[report]
fail_under = 100
show_missing = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError

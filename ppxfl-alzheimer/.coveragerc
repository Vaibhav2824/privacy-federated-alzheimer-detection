# Coverage is measured on the project's pure-logic modules and held at 100%.
#
# The omitted modules are the GPU training entry points and analysis scripts:
# every line in them is a CUDA training loop, a matplotlib render or a tqdm
# progress bar, none of which can be exercised honestly on a CPU CI runner
# without real ADNI data. They are covered by the end-to-end experiment runs
# recorded in results_v2/, not by this suite. See tests/README.md.
[run]
branch = True
source = src
omit =
    src/__pycache__/*
    src/ablations.py
    src/centralised_train.py
    src/convert_dicom.py
    src/dp_train.py
    src/evaluate.py
    src/fl_client.py
    src/fl_server.py
    src/gradcam_analysis.py
    src/mia.py
    src/preprocess.py
    src/shap_analysis.py
    src/xai_similarity.py
    # v3 pipeline: registration, skull stripping, atlas fetches, CUDA training
    # and matplotlib rendering, none of which can be exercised honestly on a CPU
    # runner without the ADNI scans. Their pure logic lives in src/orientation.py,
    # src/splits_v3.py, src/federated_v3.py, src/xai_v3.py and src/evaluate_v3.py,
    # which are covered.
    src/preprocess_v3.py
    src/orientation_search.py
    src/fit_orientation.py
    src/handedness.py
    src/features.py
    src/slices_v3.py
    src/cnn_v3.py
    src/deep_features.py
    src/mia_v3.py
    src/cnn_experiments_v3.py
    src/experiments_v3.py
    src/figures_v3.py
    # v4 expansion: DICOM series reading through SimpleITK's GDCM backend, which
    # needs real multi-slice DICOM studies to exercise at all. Its pure logic --
    # which series are structural, where a subject is filed, what the cohort is
    # short of -- lives in src/cohort_v4.py and src/ingest_v4.py, both covered.
    src/dicom_to_nifti_v4.py

[report]
fail_under = 100
show_missing = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError

# ADNI data. Access requires a data use agreement, so no scan, derived array,
# subject-level table or trained weight file is ever committed.
AD-150/
CN-150/
MCI-150/
dicom_staging/
*.zip
*.npy
*.npz
*.nii
*.nii.gz
*.dcm
*.pth
*.onnx.fp32
ppxfl-alzheimer/data/processed/
ppxfl-alzheimer/data/processed_v2/
ppxfl-alzheimer/data/clients/
ppxfl-alzheimer/data/clients_v2/
ppxfl-alzheimer/data/mni2mm/
ppxfl-alzheimer/results/checkpoints/
ppxfl-alzheimer/results_v2/checkpoints/

# Subject-level tables. These map ADNI subject identifiers to diagnosis, age or
# sex, which the data use agreement does not permit redistributing.
ppxfl-alzheimer/data/picks_adni*.csv
ppxfl-alzheimer/data/subject_class_map.json
ppxfl-alzheimer/data/demographics.csv
ppxfl-alzheimer/data/**/manifest.csv
ppxfl-alzheimer/data/**/orientation_sources.json

# The demo model is an exception to *.pth / weights: it is a quantised ONNX
# export with no recoverable training data, and the page needs it at runtime.
!ui/public/model/*.onnx

# Python
__pycache__/
*.pyc
.venv/
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
ui/dist/
ui/coverage/

# Python build outputs
ppxfl-alzheimer/dist/
ppxfl-alzheimer/build/
*.egg-info/

# Scratch space and local editor state
scratch/
.vscode/
.idea/

# Build and run logs
*.log
!paper.log

ppxfl-alzheimer/data/ida_search*.csv
ppxfl-alzheimer/data/batches/

# Machine-specific operational scripts (local paths, signed URLs)
local/

# Subject-identifier lists and extracted DICOM staging
ppxfl-alzheimer/data/cohort_v4_request.json
ppxfl-alzheimer/data/missing_*.txt
dicom_staging/

# Run logs
logs/
dicom_staging/
commitmsg.txt
